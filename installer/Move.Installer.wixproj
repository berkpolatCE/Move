<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish</AppPublishDir>
    <OutputName>Move-$(Version)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressIces>ICE91</SuppressIces>
    <DefineConstants>Version=$(Version);AppPublishDir=$(AppPublishDir)</DefineConstants>
  </PropertyGroup>

</Project>
