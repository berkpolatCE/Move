<Window x:Class="Move.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time to move"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetName="RootOffset"
                                     Storyboard.TargetProperty="Y"
                                     From="18"
                                     To="0"
                                     Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="Root" Margin="28" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootOffset" Y="18" />
        </Grid.RenderTransform>

        <Border CornerRadius="12" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.4" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                MouseLeftButtonDown="OnBackgroundMouseDown">
            <StackPanel>
                <StackPanel Margin="28,24,28,26">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="20" Height="20" Source="{StaticResource MoveLogo}" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Time to move" />
                    </StackPanel>
                    <TextBlock x:Name="ReasonText" Margin="30,2,0,0" Style="{StaticResource CaptionTextStyle}" />

                    <TextBlock x:Name="NameText"
                               Margin="0,26,0,0"
                               FontSize="30"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <Border Margin="0,10,0,0"
                            Padding="12,4"
                            HorizontalAlignment="Left"
                            CornerRadius="12"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <TextBlock x:Name="AmountText"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="TipText"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Grid x:Name="CountdownPanel" Margin="-10,18,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                AutomationProperties.Name="{Binding Text, ElementName=CountdownLabel}"
                                Click="OnCountdownButtonClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CountdownGlyph" FontSize="12" Style="{StaticResource GlyphStyle}" />
                                <TextBlock x:Name="CountdownLabel" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ProgressBar x:Name="CountdownProgress"
                                     Grid.Column="1"
                                     Margin="14,0"
                                     VerticalAlignment="Center"
                                     Maximum="1"
                                     Visibility="Hidden" />
                        <TextBlock x:Name="RemainingText"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>

                <Border Padding="28,16"
                        CornerRadius="0,0,11,11"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SnoozeButton" Click="OnSnooze" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Skip" Click="OnSkip" />
                        <Button Grid.Column="3"
                                MinWidth="120"
                                Content="Done"
                                Style="{DynamicResource AccentButtonStyle}"
                                Click="OnDone" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
