<Window x:Class="Move.Views.ReminderBanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move reminder"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="False">
    <Grid x:Name="Root" Margin="16" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootOffset" X="24" />
        </Grid.RenderTransform>

        <Border CornerRadius="10" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.4" />
            </Border.Effect>
        </Border>

        <Border Padding="16,14,20,14"
                CornerRadius="10"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="36"
                       Height="36"
                       VerticalAlignment="Top"
                       Source="{StaticResource MoveLogo}" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Time to move" />
                    <TextBlock x:Name="NameText"
                               Margin="0,2,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AmountText"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
