<ContextMenu x:Class="Move.Views.TrayMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260"
             Placement="MousePoint">
    <MenuItem Focusable="False" IsHitTestVisible="False">
        <MenuItem.Icon>
            <Image Width="18" Height="18" Source="{StaticResource MoveLogo}" />
        </MenuItem.Icon>
        <MenuItem.Header>
            <StackPanel Margin="0,4">
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Move" />
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" />
            </StackPanel>
        </MenuItem.Header>
    </MenuItem>
    <Separator />
    <MenuItem Header="Move now" Click="OnMoveNow">
        <MenuItem.Icon>
            <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE945;" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Reset timer" Click="OnReset">
        <MenuItem.Icon>
            <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE72C;" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem x:Name="PauseItem" Header="Pause">
        <MenuItem.Icon>
            <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE769;" />
        </MenuItem.Icon>
        <MenuItem Header="For 30 minutes" Tag="30" Click="OnPauseForMinutes" />
        <MenuItem Header="For 1 hour" Tag="60" Click="OnPauseForMinutes" />
        <MenuItem Header="For 2 hours" Tag="120" Click="OnPauseForMinutes" />
        <MenuItem Header="Until tomorrow" Click="OnPauseUntilTomorrow" />
        <MenuItem Header="Until I resume" Click="OnPauseUntilResumed" />
    </MenuItem>
    <MenuItem x:Name="ResumeItem" Header="Resume" Visibility="Collapsed" Click="OnResume">
        <MenuItem.Icon>
            <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE768;" />
        </MenuItem.Icon>
    </MenuItem>
    <Separator />
    <MenuItem Header="Settings" Click="OnSettings">
        <MenuItem.Icon>
            <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE713;" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Exit" Click="OnExit">
        <MenuItem.Icon>
            <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE7E8;" />
        </MenuItem.Icon>
    </MenuItem>
</ContextMenu>
